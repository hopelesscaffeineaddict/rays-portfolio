---
import { getEntry } from "astro:content";
import Can from "@/components/Can.astro";

const entry = await getEntry("site", "currently");
const items = entry?.data.items ?? [];
---

<section class="w-full px-4 py-10">
  <div class="w-full max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
    <div
      class="border border-monster/25 rounded-lg p-6 font-mono"
      style="background: rgba(0,220,50,0.07);"
    >
      <h2
        class="font-monster text-2xl uppercase tracking-widest text-monster mb-1"
        style="text-shadow: 0 0 12px rgba(0,220,50,0.3);"
      >
        // currently
      </h2>
      <div class="mt-2 mb-4 h-px bg-monster" style="box-shadow: 0 0 8px #00dc32;"></div>
      <dl class="flex flex-col gap-2">
        {
          items.map((item) => (
            <div class="flex flex-wrap gap-x-3">
              <dt class="text-monster/80">{item.label}:</dt>
              <dd class="text-white/80">{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="flex justify-center"><Can /></div>
  </div>
</section>
