---
import FormattedDate from "@/components/Date.astro";
import { realLink, type Post } from "@/lib/writing";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, date, category, description, thumbnail, venue } = post.data;
const isTalk = category === "talks";
const slides = realLink(post.data.slides_url);
const video = realLink(post.data.video_url);
---

<!-- Card is a div with a stretched title link so the slides/video buttons can be real links (no nested <a>). -->
<div
  class="group relative flex gap-4 items-stretch w-full bg-monster/5 backdrop-blur-sm border border-monster/25 rounded-lg p-4 transition-all duration-200 ease-in-out hover:border-monster/70 hover:shadow-monster-sm"
>
  {
    thumbnail && (
      <img
        src={thumbnail}
        alt=""
        loading="lazy"
        class="hidden sm:block shrink-0 w-28 h-20 object-cover rounded border border-monster/25"
      />
    )
  }
  <div class="min-w-0 flex-1 font-mono tracking-wider">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-1">
      <h3 class="text-lg text-white uppercase tracking-widest">
        <a
          href={`/writing/${post.id}`}
          class="after:absolute after:inset-0 after:content-['']"
        >
          <span class="text-monster mr-2">❯</span>{title}
        </a>
      </h3>
      <div class="flex flex-wrap items-center gap-2">
        <span
          class="px-2 py-0.5 border border-monster/50 text-monster text-xs uppercase tracking-widest rounded-sm"
          >{category}</span
        >
        {
          venue && (
            <span class="px-2 py-0.5 border border-white/30 text-white/70 text-xs uppercase tracking-widest rounded-sm">
              {venue}
            </span>
          )
        }
      </div>
    </div>
    <p class="text-monster/70 text-xs tracking-widest mb-2">
      [<FormattedDate date={date} />]
    </p>
    <p class="text-white/60 text-sm">{description}</p>
    {
      isTalk && (slides || video) && (
        <div class="relative z-10 flex flex-wrap gap-2 mt-3">
          {slides && (
            <a
              href={slides}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1 border border-monster/50 text-monster text-xs uppercase tracking-widest rounded-sm transition-colors hover:bg-monster hover:text-monster-dark"
            >
              Slides
            </a>
          )}
          {video && (
            <a
              href={video}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1 border border-monster/50 text-monster text-xs uppercase tracking-widest rounded-sm transition-colors hover:bg-monster hover:text-monster-dark"
            >
              Video
            </a>
          )}
        </div>
      )
    }
  </div>
</div>
