---
import { getEntry } from "astro:content";
import { SITE_TITLE, DISPLAY_NAME, INTRO } from "@/consts";

const currently = (await getEntry("site", "currently"))?.data.items ?? [];
---

<section
  id="hero"
  class="w-full grid grid-cols-1 md:grid-cols-2 overflow-x-hidden relative"
  style="min-height: 100svh; padding-inline: clamp(1rem, 4vw, 4rem); gap: clamp(1rem, 3vw, 3rem);"
>
  <!-- ── Left: Text Block ───────────────────────────────────────────── -->
  <div
    class="flex flex-col justify-center items-center gap-5 z-10 pt-20 md:pt-0 min-w-0 overflow-hidden"
  >
    <h1
      class="hero-title font-monster text-white uppercase tracking-widest leading-none text-center"
    >
      {DISPLAY_NAME}
    </h1>

    <p class="hero-handle">&lt;{SITE_TITLE} /&gt;</p>

    <p class="hero-about">{INTRO}</p>

  </div>

  <!-- ── Right: Dual Cans ──────────────────────────────────────────── -->
  <div
    class="flex items-center justify-center py-12 md:py-0 min-w-0"
  >
    <div id="cans-stage">

      <!-- Front can -->
      <div class="can-wrapper front-wrapper" id="front-wrapper">
        <div class="can-unit front-unit" id="front-unit">
          <div class="can-rim front-top-rim"></div>

          <div class="can-body front-body" id="front-body">
            <div class="can-banner">UNLEASH THE CODE</div>

            <div class="can-m-zone">
              <img
                src="/icons/monster_energy_v2.svg"
                alt=""
                aria-hidden="true"
                class="can-m"
              />
            </div>

            <div class="can-brand">caffeineaddict</div>
            <div class="can-person">{DISPLAY_NAME}</div>

            <div class="can-strip"></div>
            <div class="can-base"></div>
          </div>
        </div>

        <!-- Hover chrome — sits outside the tilting unit -->
        <div class="can-glow"></div>
        <div class="can-selector">[ main ]</div>
        <div class="can-panel">
          <div class="panel-rows">
            <div class="panel-row">
              <span class="pr-label">Status</span>
              <span class="pr-val pr-green">Actively Caffeinated</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Back can (nutrition / stats) -->
      <div class="can-wrapper back-wrapper" id="back-wrapper">
        <div class="can-unit back-unit" id="back-unit">
          <div class="can-rim back-top-rim"></div>

          <div class="can-body back-body" id="back-body">
            <div class="nutrition">
              <div class="nutr-head">currently</div>
              <div class="nutr-rule thick"></div>
              {currently.map((item) => (
                <>
                  <div class="nutr-row nutr-wrap">
                    <span>{item.label}</span><span class="nutr-val">{item.value}</span>
                  </div>
                  <div class="nutr-rule thin"></div>
                </>
              ))}
            </div>

            <div class="can-strip"></div>
            <div class="can-base"></div>
          </div>
        </div>

        <div class="can-glow"></div>
        <div class="can-selector">[ currently ]</div>
      </div>

    </div><!-- #cans-stage -->
  </div>
</section>

<script is:inline>
  // Re-attach hover handlers after every navigation (View Transitions).
  // Guard with data-bound so listeners are never added more than once per element.
  document.addEventListener("astro:page-load", function () {
    document.querySelectorAll(".can-wrapper").forEach(function (wrapper) {
      if (wrapper.dataset.bound) return;
      wrapper.dataset.bound = "1";

      var unit = wrapper.querySelector(".can-unit");
      if (!unit) return;

      wrapper.addEventListener("mouseenter", function () {
        unit.style.transition = "transform 0.2s ease";
        unit.style.transform = "scale(1.04)";
      });

      wrapper.addEventListener("mouseleave", function () {
        unit.style.transition = "transform 0.4s ease-out";
        unit.style.transform = "";
      });

      wrapper.addEventListener("click", function () {
        wrapper.classList.toggle("expanded");
      });
    });
  });
</script>

<style>
  /* ── Stage ───────────────────────────────────────────────────────── */
  #cans-stage {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
  }

  /* On single-column layout (< 768px), constrain stage width */
  @media (max-width: 767px) {
    #cans-stage {
      max-width: min(380px, 85vw);
      margin-inline: auto;
    }
  }

  /* ── Can wrapper ─────────────────────────────────────────────────── */
  .can-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
  }

  .front-wrapper {
    z-index: 2;
  }

  .back-wrapper {
    --overlap: clamp(22px, 2.4vw, 34px);
    z-index: 1;
    /*
     * Fixed: was clamp(-36px, -4.4vw, -56px) which always resolved to -36px
     * because CSS clamp(MIN,VAL,MAX) = max(MIN, min(VAL,MAX)) and with
     * MIN(-36) > MAX(-56) the result was always -36px regardless of viewport.
     * Correct direction: clamp(-56px, -4.4vw, -36px) scales overlap with width.
     */
    margin-left: calc(var(--overlap) * -1);
  }

  .back-wrapper:hover {
    z-index: 3;
  }

  /* ── Can unit ────────────────────────────────────────────────────── */
  .can-unit {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .back-unit {
    transform-origin: bottom center;
  }

  /* ── Shape ───────────────────────────────────────────────────────────
   * --ry is half the height of the lid ellipse. The lid overlaps the top of the
   * body by --ry, and the body's bottom edge is an ellipse of the same radius,
   * so the silhouette reads as a cylinder. The green band and the silver base
   * are children of the body: the body's curved bottom clips them, and a mask
   * gives their top edges the same curve, so they wrap the can.
   */
  .front-unit {
    --ry: clamp(8px, 0.95vw, 12px);
    --band: clamp(12px, 1.4vw, 18px);
    --b: clamp(5px, 0.6vw, 8px);
  }
  .back-unit {
    --ry: clamp(7px, 0.8vw, 10px);
    --band: clamp(10px, 1.2vw, 15px);
    --b: clamp(4px, 0.5vw, 7px);
  }

  .can-rim {
    position: relative;
    z-index: 3;
    flex-shrink: 0;
    width: 100%;
    height: calc(var(--ry) * 2);
    margin-bottom: calc(var(--ry) * -1);
    border-radius: 50%;
    background:
      radial-gradient(
        ellipse 64% 52% at 50% 50%,
        #161616 0,
        #262626 62%,
        #5a5a5a 78%,
        transparent 80%
      ),
      linear-gradient(
        90deg,
        #5c5c5c 0%,
        #d8d8d8 22%,
        #f2f2f2 34%,
        #a8a8a8 60%,
        #6a6a6a 85%,
        #444 100%
      );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.55),
      0 2px 6px rgba(0, 0, 0, 0.85);
  }

  /* ── Can body ────────────────────────────────────────────────────── */
  .can-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    overflow: hidden;
    will-change: transform;
    border-radius: 0 0 50% 50% / 0 0 var(--ry) var(--ry);
  }
  /* shadow cast by the lid onto the shoulder */
  .can-body::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: calc(var(--ry) * 3);
    background: linear-gradient(rgba(0, 0, 0, 0.6), transparent);
    z-index: 2;
    pointer-events: none;
  }

  .front-body {
    /*
     * Width and height both use min(vw, vh) so the can aspect ratio (~2.55:1)
     * is preserved on short-screen laptops.
     */
    width: clamp(180px, min(22vw, 27.5vh), 280px);
    height: clamp(300px, min(55.8vw, 70vh), 714px);
    background:
      linear-gradient(
        to right,
        rgba(0, 0, 0, 0.5) 0%,
        rgba(0, 0, 0, 0.2) 10%,
        rgba(255, 255, 255, 0.12) 16%,
        rgba(255, 255, 255, 0.04) 26%,
        transparent 38%,
        transparent 68%,
        rgba(0, 0, 0, 0.28) 82%,
        rgba(0, 0, 0, 0.58) 100%
      ),
      linear-gradient(to right, #0e0e0e 0%, #1f1f1f 20%, #1c1c1c 50%, #141414 80%, #080808 100%);
    box-shadow: 0 24px 72px rgba(0, 0, 0, 0.85);
  }

  .back-body {
    width: clamp(153px, min(18.7vw, 23.4vh), 238px);
    height: clamp(260px, min(52vw, 68vh), 664px);
    background:
      linear-gradient(
        to right,
        rgba(0, 0, 0, 0.45) 0%,
        rgba(255, 255, 255, 0.08) 15%,
        rgba(255, 255, 255, 0.03) 26%,
        transparent 38%,
        transparent 70%,
        rgba(0, 0, 0, 0.38) 88%,
        rgba(0, 0, 0, 0.62) 100%
      ),
      linear-gradient(to right, #0a0a0a 0%, #181818 22%, #151515 50%, #0e0e0e 80%, #060606 100%);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.75);
  }

  /* ── Bottom: green band + silver base, both wrapping the curve ───── */
  .can-strip,
  .can-base {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    -webkit-mask-image: radial-gradient(
      ellipse 50% var(--ry) at 50% 0,
      transparent calc(100% - 1px),
      #000 100%
    );
    mask-image: radial-gradient(
      ellipse 50% var(--ry) at 50% 0,
      transparent calc(100% - 1px),
      #000 100%
    );
  }
  .can-strip {
    height: calc(var(--band) + var(--b) + var(--ry));
    background:
      linear-gradient(
        to right,
        rgba(0, 0, 0, 0.5) 0%,
        rgba(255, 255, 255, 0.18) 16%,
        transparent 34%,
        transparent 68%,
        rgba(0, 0, 0, 0.55) 100%
      ),
      linear-gradient(180deg, #00ff44 0%, #00dc32 45%, #009922 100%);
  }
  .can-base {
    height: calc(var(--b) + var(--ry));
    background: linear-gradient(
      to right,
      #4a4a4a 0%,
      #cfcfcf 20%,
      #f0f0f0 32%,
      #9a9a9a 58%,
      #5e5e5e 85%,
      #3a3a3a 100%
    );
  }

  /* ── Front can label content ─────────────────────────────────────── */
  .can-banner {
    width: 100%;
    padding: calc(var(--ry) + 8px) 0 calc(var(--ry) * 0.7 + 6px);
    background: rgba(0, 0, 0, 0.72);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0 0 50% 50% / 0 0 var(--ry) var(--ry);
    font-family: "MonsterFont", "VCRosdNEUE", sans-serif;
    font-size: clamp(11px, min(1.75vw, 2.15vh), 18px);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    text-align: center;
    font-variant: small-caps;
    white-space: nowrap;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .can-m-zone {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: clamp(10px, 1.3vw, 20px) clamp(14px, 1.8vw, 24px);
    min-height: 0;
    position: relative;
    z-index: 1;
  }

  .can-m {
    width: 84%;
    height: auto;
    filter: drop-shadow(0 0 18px rgba(0, 220, 50, 0.72));
  }

  .can-brand {
    font-family: "MonsterFont", "VCRosdNEUE", sans-serif;
    font-size: clamp(12px, min(2.05vw, 2.5vh), 26px);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    text-align: center;
    width: 100%;
    padding: 0 6px clamp(4px, 0.45vw, 6px);
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .can-person {
    font-family: "Barlow Condensed", sans-serif;
    font-style: normal;
    font-weight: 700;
    font-size: clamp(13px, min(2vw, 2.5vh), 26px);
    color: #00dc32;
    text-align: center;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    /* clear the green band */
    padding-bottom: calc(var(--band) + var(--b) + var(--ry) + clamp(6px, 0.7vw, 10px));
    text-shadow: 0 0 10px rgba(0, 220, 50, 0.65);
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  /* ── Back can: "currently" label ─────────────────────────────────── */
  .nutrition {
    padding: calc(var(--ry) + 10px) clamp(8px, 0.9vw, 12px) 0
      calc(var(--overlap) + clamp(8px, 0.9vw, 12px));
    background: transparent;
    color: rgba(255, 255, 255, 0.88);
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 3px;
    box-sizing: border-box;
    overflow: hidden;
    position: relative;
    z-index: 1;
  }

  .nutr-head {
    font-family: "MonsterFont", sans-serif;
    font-size: clamp(13px, min(1.9vw, 2.3vh), 22px);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    line-height: 1;
    padding-bottom: 5px;
    flex-shrink: 0;
  }

  .nutr-rule {
    height: 1px;
    background: rgba(255, 255, 255, 0.2);
    width: 100%;
    flex-shrink: 0;
  }
  .nutr-rule.thick {
    height: 5px;
    background: rgba(255, 255, 255, 0.4);
  }
  .nutr-rule.thin {
    background: rgba(255, 255, 255, 0.12);
  }

  .nutr-row {
    font-family: "Share Tech Mono", monospace;
    font-size: clamp(11px, min(1.4vw, 1.75vh), 17px);
    color: rgba(255, 255, 255, 0.82);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    padding: 4px 0;
    gap: 2px 8px;
    flex-shrink: 0;
  }
  .nutr-val {
    margin-left: auto;
    text-align: right;
    color: #fff;
    font-weight: 700;
  }

  /* ── Glow pool beneath each can ──────────────────────────────────── */
  .can-glow {
    width: clamp(90px, 9vw, 130px);
    height: clamp(16px, 1.6vw, 22px);
    border-radius: 50%;
    background: #00dc32;
    filter: blur(18px);
    opacity: 0;
    transition: opacity 0.3s ease;
    margin-top: clamp(-10px, -1.1vw, -14px);
    flex-shrink: 0;
  }
  .can-wrapper:hover .can-glow {
    opacity: 0.52;
  }

  /* ── Selector bracket ────────────────────────────────────────────── */
  .can-selector {
    font-family: "Share Tech Mono", monospace;
    font-size: clamp(12px, 1.1vw, 15px);
    color: #00dc32;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0;
    transition: opacity 0.2s ease;
    margin-top: 16px;
    text-shadow: 0 0 6px rgba(0, 220, 50, 0.7);
    flex-shrink: 0;
    white-space: nowrap;
  }
  .can-wrapper:hover .can-selector {
    opacity: 1;
  }

  /* ── Info panel under [ main ] ───────────────────────────────────── */
  .can-panel {
    width: clamp(180px, 22vw, 280px);
    /* Safety net: never wider than the viewport */
    max-width: calc(100vw - 2rem);
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      max-height 0.35s ease,
      opacity 0.25s ease,
      padding 0.25s ease;
    background: rgba(0, 220, 50, 0.05);
    border: 1px solid rgba(0, 220, 50, 0.2);
    border-radius: 4px;
    margin-top: 6px;
    box-sizing: border-box;
    flex-shrink: 0;
  }
  .can-wrapper:hover .can-panel {
    max-height: 160px;
    opacity: 1;
    padding: 10px 14px;
  }

  /* ── About me blurb ──────────────────────────────────────────────── */
  .hero-about {
    font-family: "Share Tech Mono", monospace;
    font-size: clamp(10px, 1.1vw, 16px);
    color: rgba(255, 255, 255, 0.80);
    text-align: center;
    line-height: 1.75;
    margin: 0;
    max-width: 50ch;
    word-break: break-word;
  }

  /* ── Hero title — fluid type, never forces horizontal scroll ─────── */
  .hero-title {
    font-size: clamp(1.5rem, 4vw, 4.5rem);
    text-align: center;
  }

  .hero-handle {
    font-family: "MonsterFont", "VCRosdNEUE", sans-serif;
    font-size: clamp(1rem, 2vw, 1.75rem);
    color: #00dc32;
    text-shadow: 0 0 8px rgba(0, 220, 50, 0.45);
    letter-spacing: 0.1em;
    text-align: center;
    margin: 0;
  }

  .panel-line {
    font-family: "Share Tech Mono", monospace;
    font-size: clamp(13px, 1.4vw, 16px);
    color: #00dc32;
    text-shadow: 0 0 8px rgba(0, 220, 50, 0.5);
    letter-spacing: 0.04em;
    margin: 0 0 8px;
  }

  .panel-rows {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .panel-row {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 3px 0;
    font-family: "Share Tech Mono", monospace;
    font-size: clamp(12px, 1.2vw, 14px);
  }
  .pr-label {
    color: rgba(255, 255, 255, 0.38);
    white-space: nowrap;
  }
  .pr-val {
    color: rgba(255, 255, 255, 0.85);
    text-align: right;
  }
  .pr-green {
    color: #00dc32;
  }

</style>
