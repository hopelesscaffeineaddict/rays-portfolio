---
import { SITE_TITLE, DISPLAY_NAME, TAGLINE, INTRO } from "@/consts";
---

<section
  id="hero"
  class="w-full flex flex-col items-center justify-center text-center gap-4 relative"
  style="min-height: 60svh; padding-inline: clamp(1rem, 4vw, 4rem);"
>
  <h1
    class="hero-name font-monster text-white uppercase tracking-widest leading-none"
    style="text-shadow: 0 0 20px rgba(0,220,50,0.35);"
  >
    {DISPLAY_NAME}
  </h1>
  <p class="hero-handle font-monster text-monster tracking-widest" style="text-shadow: 0 0 8px rgba(0,220,50,0.45);">
    &lt;{SITE_TITLE} /&gt;
  </p>
  <p class="hero-tagline">{TAGLINE}</p>
  <p class="hero-about">{INTRO}</p>
</section>

<style>
  .hero-name {
    font-size: clamp(2.5rem, 8vw, 6rem);
  }
  .hero-handle {
    font-size: clamp(1rem, 2.4vw, 1.75rem);
    margin: 0;
  }
  .hero-tagline {
    font-family: "Share Tech Mono", monospace;
    font-size: clamp(12px, 1.6vw, 18px);
    color: #00dc32;
    text-shadow: 0 0 8px rgba(0, 220, 50, 0.45);
    line-height: 1.5;
    max-width: 60ch;
    margin: 0;
  }
  .hero-about {
    font-family: "Share Tech Mono", monospace;
    font-size: clamp(12px, 1.2vw, 16px);
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.75;
    max-width: 60ch;
    margin: 0;
  }
</style>
